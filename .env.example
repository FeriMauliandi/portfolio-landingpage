# Groq API Configuration for AI Portfolio Chatbot
# Dapatkan API key gratis di: https://console.groq.com/keys

# ⚠️ PENTING: JANGAN gunakan prefix VITE_ — key ini hanya boleh diakses
#    oleh server (Vercel Serverless Function), BUKAN oleh browser.

# Masukkan API Key Groq Anda di sini:
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Groq yang digunakan (default: qwen/qwen3.8-27b)
# Pilihan populer di Groq:
# - qwen/qwen3.8-27b
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
GROQ_MODEL=qwen/qwen3.8-27b
