# Groq API Configuration for AI Portfolio Chatbot
# Dapatkan API key gratis di: https://console.groq.com/keys

# Masukkan API Key Groq Anda di sini:
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Model Groq yang digunakan (default: qwen-2.5-32b)
# Pilihan populer di Groq:
# - qwen-2.5-32b
# - qwen-2.5-coder-32b
# - llama-3.3-70b-versatile
# - llama-3.1-8b-instant
VITE_GROQ_MODEL=qwen-2.5-32b
